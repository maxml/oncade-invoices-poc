# Oncade TEST platform key (dev.oncade.xyz -> Platforms -> API Keys). Only oncade_platform_test_... is accepted.
ONCADE_API_KEY=
# Business the platform acts for (X-Target-Business-Id); shown in the developer portal.
ONCADE_BUSINESS_ID=
# Platform -> Settings -> webhook secret (needed only for webhooks).
ONCADE_WEBHOOK_SECRET=

# LLM: a logged-in Claude Code CLI is used by default. Prefer an API key: with it set, the sandbox
# binds nothing from $HOME (no Claude credentials file inside the sandbox).
# ANTHROPIC_API_KEY=
AGENT_MODEL=sonnet
# auto = use bubblewrap when installed (Linux), off = never, on = required
AGENT_SANDBOX=auto
# Per-run limits: wall clock, agent turns, dollars.
# AGENT_TIMEOUT_MS=180000
# AGENT_MAX_TURNS=12
# AGENT_MAX_BUDGET_USD=0.5
# Daily cap over all runs and processes (UTC day): costs in data/runs.jsonl plus runs in flight,
# each reserving AGENT_MAX_BUDGET_USD (data/budget-reservations.json). A run starts only if its
# reservation fits; over it, /ask answers 429 and `pnpm ask` exits non-zero. 0 blocks every run.
# AGENT_DAILY_BUDGET_USD=2

# Required: the server refuses to start with empty or default values.
# ADMIN_PASSWORD: at least 12 characters. SESSION_SECRET: at least 32, e.g. `openssl rand -hex 32`.
ADMIN_USER=admin
ADMIN_PASSWORD=
SESSION_SECRET=
# Local demo only: set to 1 to start with admin/admin and a built-in session secret (loud warning).
# ALLOW_INSECURE_DEFAULTS=1
# The UI (login, /ask, /healthz) on 127.0.0.1:PORT; never tunnel this port.
PORT=3000
# The webhook receiver (only POST /webhooks/oncade) on 127.0.0.1:WEBHOOK_PORT; `pnpm tunnel` exposes this one.
WEBHOOK_PORT=3001
