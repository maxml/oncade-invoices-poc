# Oncade TEST platform key (dev.oncade.xyz -> Platforms -> API Keys). Only oncade_platform_test_... is accepted.
ONCADE_API_KEY=
# Business the platform acts for (X-Target-Business-Id); shown in the developer portal.
ONCADE_BUSINESS_ID=
# Platform -> Settings -> webhook secret (needed only for webhooks).
ONCADE_WEBHOOK_SECRET=

# LLM: a logged-in Claude Code CLI is used by default. Set this only if you prefer an API key.
# ANTHROPIC_API_KEY=
AGENT_MODEL=sonnet
# auto = use bubblewrap when installed (Linux), off = never, on = required
AGENT_SANDBOX=auto

ADMIN_USER=admin
ADMIN_PASSWORD=admin
SESSION_SECRET=change-me
PORT=3000
